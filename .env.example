# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recruiting
POSTGRES_PORT=5432
DATABASE_URL=postgresql://copilot:change-me@localhost:5432/recruiting

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Slack (Day 4)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=           # channel ID of #recruiting (starts with C)

# n8n (Day 4)
N8N_PORT=5678

# Shared key n8n -> API, generate with: openssl rand -hex 32
COPILOT_API_KEY=
# Leave empty for the local API; set to the Cloud Run URL after deploying
COPILOT_API_URL=
